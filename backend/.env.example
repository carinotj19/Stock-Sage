# Environment mode. Keep development locally; hosted deployments should use production.
STOCK_SAGE_ENV=development

# Neon PostgreSQL connection (required)
# Format:
# postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://neondb_owner:replace-me@your-neon-host.neon.tech/neondb?sslmode=require

# Frontend origins allowed by backend CORS and trusted for browser write requests.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin login sessions. Admin users are stored in the database and created by CLI.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_TTL_SECONDS=86400

# For cross-site hosted frontend/backend domains, use:
# ADMIN_COOKIE_SECURE=true
# ADMIN_COOKIE_SAMESITE=none

# Local/test convenience only. Ignored when STOCK_SAGE_ENV=production.
# STOCK_SAGE_AUTH_DISABLED=true
